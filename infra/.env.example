# Copy to the repository root and fill in:   cp infra/.env.example .env
# .env is git-ignored. Never commit real values.

# --- Storage (dfoot_core.settings) -----------------------------------------
# "local" works without any Cloudflare account; "r2" for production.
STORAGE_BACKEND=local
# Local storage directory, relative to where the code runs (outside Docker).
LOCAL_DATA_DIR=data
# Cloudflare R2, only needed when STORAGE_BACKEND=r2 (see docs/deploiement.md).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- Postgres (Airflow metadata) -------------------------------------------
POSTGRES_USER=airflow
# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=airflow

# --- Airflow ---------------------------------------------------------------
# Generate: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=
# Generate: openssl rand -hex 32
AIRFLOW__API_AUTH__JWT_SECRET=

# --- Published ports (bound to 127.0.0.1 only) -----------------------------
API_PORT=8000
WEB_PORT=8080

# --- Public access (nginx + Certbot) ---------------------------------------
# Your domain name, e.g. dfoot.example.org (no scheme, no trailing slash).
DFOOT_DOMAIN=
# Let's Encrypt expiry notices.
LETSENCRYPT_EMAIL=
