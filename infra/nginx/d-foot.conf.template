# Reverse proxy for D-Foot: / -> web, /api/ -> api.
#
# This is a template: ${DFOOT_DOMAIN}, ${API_UPSTREAM} and ${WEB_UPSTREAM} are
# replaced by envsubst. Variables like $host are nginx's own and are left
# untouched, because envsubst only replaces variables defined in the environment.
#   - nginx in Docker (mode 1): done automatically by the official image.
#   - nginx on the host (mode 2): see docs/deploiement.md.

# Port 80: Let's Encrypt challenges, everything else goes to HTTPS.
server {
    listen 80;
    listen [::]:80;
    server_name ${DFOOT_DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on; # nginx >= 1.25.1; older versions: "listen 443 ssl http2;" instead
    server_name ${DFOOT_DOMAIN};

    # Certificates written by Certbot.
    ssl_certificate     /etc/letsencrypt/live/${DFOOT_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DFOOT_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;

    access_log /var/log/nginx/access.log combined; # stdout in the Docker image

    # The API takes no uploads: small request bodies are enough.
    client_max_body_size 2m;

    # Security headers. "always" also adds them to error responses.
    # Note: an add_header inside a location would drop all of these for that location.
    add_header Strict-Transport-Security "max-age=31536000" always; # HTTPS only, for 1 year
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Compress text responses (HTML is always compressed when gzip is on).
    gzip on;
    gzip_proxied any;
    gzip_min_length 1024;
    gzip_types text/css text/plain application/javascript application/json image/svg+xml;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # The trailing "/" on proxy_pass strips the prefix: /api/health -> /health.
    location /api/ {
        proxy_pass http://${API_UPSTREAM}/;
    }

    location / {
        proxy_pass http://${WEB_UPSTREAM};
    }
}
